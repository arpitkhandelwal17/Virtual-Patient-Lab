# Copy this file to ".env" and fill in your own values.
# The ".env" file is private and is never saved to Git.

# PostgreSQL connection. Leave this empty for development: "uv run start-db" runs a
# local database that needs no password and the server finds it by itself.
# Fill it in only for the live server, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/virtual_patient_lab
DATABASE_URL=

# How simulation numbers are extracted from label and paper text.
# "manual"  = data-preparation queue, prepared with Claude Code (default, no cost)
# "ollama"  = free local AI model (optional, needs a powerful computer)
# No paid API is used.
EXTRACTION_MODE=manual
OLLAMA_URL=http://localhost:11434

# PubMed (NCBI) asks for a contact email; an API key is free and optional
NCBI_EMAIL=
NCBI_API_KEY=

# openFDA API key (free and optional; works without one at lower limits)
OPENFDA_API_KEY=

# Fixed seed for virtual population generation (keep the same for reproducible results)
POPULATION_SEED=20261009
